 	addik	r31, r0, init_task
diff --git a/arch/microblaze/kernel/hw_exception_handler.S b/arch/microblaze/=
kernel/hw_exception_handler.S
index 07ea239..a13d734 100644
--- a/arch/microblaze/kernel/hw_exception_handler.S
+++ b/arch/microblaze/kernel/hw_exception_handler.S
@@ -908,9 +908,19 @@ ex_unaligned_fixup:
 	addik	r7, r0, SIGSEGV
 	/* call bad_page_fault for finding aligned fixup, fixup address is saved
 	 * in PT_PC which is used as return address from exception */
-	addik	r15, r0, ret_from_exc-8 /* setup return address */
+	/*
+	 * bad_page_fault is C and r1 is the pt_regs base, so its ABI
+	 * argument save area would be pt_regs itself; this binary's
+	 * bad_page_fault spills r6/r7 to caller_sp+4/+12 =3D PT_R1/PT_R3.
+	 * Reserve the area and return through a trampoline, since r15
+	 * points at ret_from_exc-8.
+	 */
+	addik	r15, r0, 3f-8 /* setup return address */
+	addik	r1, r1, -32 /* MicroBlaze ABI argument save area */
 	brid	bad_page_fault
 	nop
+3:	addik	r1, r1, 32
+	bri	ret_from_exc
=20
 /* We prevent all load/store because it could failed any attempt to access */
 .section __ex_table,"a";
