 	mfs	r4, rear		/* EAR */
@@ -599,11 +646,14 @@ C_ENTRY(page_fault_data_trap):
 	swi	r17, r1, PT_PC;
 	tovirt(r1,r1)
 	/* where the trap should return need -8 to adjust for rtsd r15, 8 */
-	addik	r15, r0, ret_from_exc-8
+	addik	r15, r0, 7f-8
