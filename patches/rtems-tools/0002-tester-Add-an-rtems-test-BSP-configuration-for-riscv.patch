+#
+# The RISC-V MicroBlaze-V (riscv/mbv) BSP on QEMU.
+#
+# The machine takes its image through a loader device rather than -kernel, so
+# bsp_qemu_image_type and bsp_qemu_image_path are overridden rather than using
+# the qemu.cfg defaults.  arch is riscv32 so that qemu-system-riscv32 is
+# selected; the RTEMS architecture directory is riscv.
+#
+[mbv_qemu]
+bsp                 = mbv_qemu
+arch                = riscv32
+tester              = %{_rtscripts}/qemu.cfg
+bsp_qemu_opts       = -M amd-microblaze-v-generic -m 256m -no-reboot -icount shift=0,sleep=off -display none -monitor none -serial stdio
+bsp_qemu_image_type = -device
+bsp_qemu_image_path = loader,file=%{test_executable},cpu-num=0
